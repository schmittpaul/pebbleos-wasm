From 1328651181d846aab498f58d3605a4fbfd795e71 Mon Sep 17 00:00:00 2001
From: Paul Schmitt <paul.schmitt@gmail.com>
Date: Mon, 21 Sep 2026 16:46:19 -0700
Subject: [PATCH 2/2] launcher: keep the clock hands under the dial
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The launcher runs in place of the watchface, so the watchface's own hands
cannot be drawn underneath: its process is gone and there is one app
framebuffer. compositor_get_app_framebuffer_as_bitmap() serves transitions,
not a persistent underlay. The launcher therefore draws the time itself
from rtc_get_time(), which the app glances here already use.

Drawing its own hands is also the better answer: a watchface may be digital
or a photo, and a ring of apps over an arbitrary background would not be
readable. Minimal hands are legible over anything.

This needed a layout change, not just a draw call. With the app name in the
middle, the label had to punch a white hole through the hub to stay
readable, which left the hands as two disconnected stubs — present, but not
reading as hands. The name now sits in a band below the dial
(RADIAL_LABEL_BAND, excluded from the radius so the dial cannot collide
with it) and the centre belongs to the hands, which get their proper weight
back at 5 px and 3 px with a visible hub.

Three concentric zones that do not overlap: hands at the centre, apps on
the ring, the selected app's name in the band.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../launcher/default/radial_menu_layer.c      | 53 +++++++++++++++----
 1 file changed, 44 insertions(+), 9 deletions(-)

diff --git a/src/fw/apps/system/launcher/default/radial_menu_layer.c b/src/fw/apps/system/launcher/default/radial_menu_layer.c
index 398fe60..459e419 100644
--- a/src/fw/apps/system/launcher/default/radial_menu_layer.c
+++ b/src/fw/apps/system/launcher/default/radial_menu_layer.c
@@ -24,10 +24,12 @@
 #include "applib/ui/app_window_stack.h"
 #include "applib/ui/window.h"
 #include "process_management/app_manager.h"
+#include "pbl/drivers/rtc.h"
 #include "pbl/util/misc.h"
 #include "pbl/util/size.h"
 #include "pbl/util/trig.h"
 #include "shell/system_theme.h"
+#include "util/time/time.h"
 #include "system/passert.h"
 
 #if CONFIG_LAUNCHER_RADIAL
@@ -42,6 +44,14 @@
 #define RADIAL_PCT_DOT 11
 #define RADIAL_PCT_DOT_SELECTED 14
 #define RADIAL_PCT_HALO 20
+#define RADIAL_PCT_HAND_HOUR 42
+#define RADIAL_PCT_HAND_MINUTE 62
+
+//! The app name sits in a band below the dial rather than in the middle.
+//! The centre belongs to the hands: a label there has to punch a hole in
+//! them to stay readable, which leaves the hands as disconnected stubs and
+//! stops the dial reading as a clock at all.
+#define RADIAL_LABEL_BAND 24
 
 typedef struct {
   GPoint center;
@@ -50,6 +60,8 @@ typedef struct {
   int16_t dot;
   int16_t dot_selected;
   int16_t halo;
+  int16_t hand_hour;
+  int16_t hand_minute;
 } RadialDial;
 
 static const LauncherMenuLayerStyle s_styles[NumPreferredContentSizes] = {
@@ -79,15 +91,18 @@ const LauncherMenuLayerStyle *launcher_menu_layer_get_style(void) {
 // Geometry
 
 static RadialDial prv_dial(GRect bounds) {
-  const int16_t span = MIN(bounds.size.w, bounds.size.h);
+  const int16_t usable_h = (int16_t)(bounds.size.h - RADIAL_LABEL_BAND);
+  const int16_t span = MIN(bounds.size.w, usable_h);
   const int16_t r = (int16_t)(span / 2 - 6);
